@page "/listview"

@inject IAppInfo appInfo
@inject TransporterListViewModel ViewModel
@inject ITransporterHelper transporterHelper

<h1>Units</h1>

@if (ViewModel.Transporters is null)
{
	<p><em>Loading...</em></p>
}
else
{
	<table class="@tableStyle">
		<thead>
			<tr>
				<th>Name</th>
				<th>Date Time</th>
				<th>Speed (Km/Hr)</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in ViewModel.Transporters)
			{
				<tr @onclick="() => ViewModel.OnRowClick(item)">
					<td>@item.DeviceName</td>
					<td>@transporterHelper.GetTimeDifference(item.DeviceDateTime.DateTime)</td>
					<td>@item.Speed</td>
				</tr>
			}
		</tbody>
	</table>
}

@if (ViewModel.SelectedTransporter is not null)
{
	<TransporterDetail TransporterId="ViewModel.SelectedTransporter?.TransporterId" />
}