<!-- For more info on central package management go to https://devblogs.microsoft.com/nuget/introducing-central-package-management/ -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <TrackHubCommonVersion>1.0.15</TrackHubCommonVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Ardalis.GuardClauses" Version="5.0.0" />
    <PackageVersion Include="Geotab.Checkmate.ObjectModel" Version="11.132.485" />
    <PackageVersion Include="GraphQL.Client" Version="6.1.0" />
    <PackageVersion Include="GraphQL.Client.Serializer.SystemTextJson" Version="6.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.15" />
    <PackageVersion Include="TrackHubCommon.Application" Version="$(TrackHubCommonVersion)" />
    <PackageVersion Include="TrackHubCommon.Domain" Version="$(TrackHubCommonVersion)" />
    <PackageVersion Include="TrackHubCommon.Infrastructure" Version="$(TrackHubCommonVersion)" />
    <PackageVersion Include="TrackHubCommon.Web" Version="$(TrackHubCommonVersion)" />
    <PackageVersion Include="HotChocolate.AspNetCore" Version="16.5.0" />
    <PackageVersion Include="HotChocolate.AspNetCore.Authorization" Version="16.5.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>
  <!-- Local override point: restores pick up property overrides (e.g. TrackHubCommonVersion) from an
       optional sibling file that is not part of this repository. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Packages.Edition.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Packages.Edition.props')" />
</Project>