         TrackHub.Geofencing was cloned from Manager and its assemblies are literally named
         TrackHub.Manager.Application/Domain/Infrastructure — they cannot be loaded alongside
         Manager's real assemblies in one process. -->
    <ProjectReference Include="..\..\..\TrackHub.Geofencing\src\Web\Web.csproj" />
    <!-- Consumers of the Geofence producer. -->
    <ProjectReference Include="..\..\..\TrackHubRouter\src\Infrastructure\GeofenceApi\GeofenceApi.csproj" />
    <ProjectReference Include="..\..\..\TrackHub.Reporting\src\Infrastructure\GraphQLApi\GraphQLApi.csproj" />
