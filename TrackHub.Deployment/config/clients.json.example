{
  "scopes": [
    {
      "name": "web_scope",
      "resource": "trackhub_api"
    },
    {
      "name": "mobile_scope",
      "resource": "trackhub_api"
    },
    {
      "name": "staff_mobile_scope",
      "resource": "trackhub_api"
    },
    {
      "name": "service_scope",
      "resource": "trackhub_api"
    }
  ],
  "PKCEClients": [
    {
      "clientId": "web_client",
      "uri": "https://<<YOUR_DOMAIN>>/authentication/callback",
      "postLogoutUri": "https://<<YOUR_DOMAIN>>/",
      "scope": "web_scope"
    },
    {
      "clientId": "mobile_client",
      "uri": "trackhubmobile://callback",
      "postLogoutUri": "trackhubmobile://callback",
      "scope": "mobile_scope",
      "passwordGrant": true
    },
    {
      "clientId": "staff_mobile_client",
      "uri": "trackhubstaff://callback",
      "postLogoutUri": "trackhubstaff://callback",
      "scope": "staff_mobile_scope"
    }
  ],
  "serviceClients": [
    {
      "clientId": "syncworker_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "router_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "security_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "geofence_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "trip_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "manager_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    },
    {
      "clientId": "reporting_client",
      "clientSecret": "<<GENERATE_A_SECURE_SECRET>>",
      "scope": "service_scope"
    }
  ]
}
