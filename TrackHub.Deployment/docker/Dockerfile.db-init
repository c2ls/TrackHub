# Database Initialization Container
# Runs ClientSeeder and DBInitializers once during initial deployment

# Stage 1: Build all three database initializers
# TrackHubCommon is a ProjectReference, so every service is copied under its
# real repository path and restores resolve it directly.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY global.json Directory.Build.props Directory.Packages.props ./
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHub.AuthorityServer/ TrackHub.AuthorityServer/
COPY TrackHubSecurity/ TrackHubSecurity/
COPY TrackHub.Manager/ TrackHub.Manager/

RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages dotnet publish TrackHub.AuthorityServer/src/ClientSeeder/ClientSeeder.csproj -c Release -o /app/client-seeder
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages dotnet publish TrackHubSecurity/src/DBInitializer/DBInitializer.csproj      -c Release -o /app/security-init
RUN --mount=type=cache,id=nuget,target=/root/.nuget/packages dotnet publish TrackHub.Manager/src/DBInitializer/DBInitializer.csproj      -c Release -o /app/manager-init

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install PostgreSQL client for connectivity checks
RUN apt-get update && apt-get install -y postgresql-client gdal-bin curl unzip && rm -rf /var/lib/apt/lists/*

# Local geocoding data build (import-geocoding.sh)
ARG DUCKDB_VERSION=1.5.5
RUN curl -fsSL -o /tmp/duckdb.zip "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-$(dpkg --print-architecture).zip" \
    && unzip /tmp/duckdb.zip -d /usr/local/bin && rm /tmp/duckdb.zip \
    && duckdb -c "INSTALL httpfs; INSTALL spatial; INSTALL postgres;"

# Copy published applications
COPY --from=build /app/client-seeder ./client-seeder/
COPY --from=build /app/security-init ./security-init/
COPY --from=build /app/manager-init ./manager-init/

# Copy initialization scripts
COPY TrackHub.Deployment/scripts/init-databases.sh ./init-databases.sh
COPY TrackHub.Deployment/scripts/import-geocoding.sh ./import-geocoding.sh
COPY TrackHub.Deployment/scripts/sql/purge-functions.sql TrackHub.Deployment/scripts/sql/geocoding-schema.sql TrackHub.Deployment/scripts/sql/geocoding-load.sql ./sql/
RUN chmod +x ./init-databases.sh ./import-geocoding.sh

ENTRYPOINT ["./init-databases.sh"]
