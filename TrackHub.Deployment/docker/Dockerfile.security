# TrackHub Security API (GraphQL)
# Multi-stage build for .NET 10

# Stage 1: Build
# TrackHubCommon is a ProjectReference now (not a packed NuGet feed), so it must
# be present in the same layout as the repository and restores resolve it directly.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Central build configuration, shared by every project.
COPY global.json Directory.Packages.props ./

# Project files first: this layer only changes when a dependency changes,
# so the restore below stays cached across ordinary source edits.
COPY TrackHubCommon/Directory.Build.props TrackHubCommon/
COPY TrackHubCommon/src/Common.Application/Common.Application.csproj TrackHubCommon/src/Common.Application/
COPY TrackHubCommon/src/Common.Domain/Common.Domain.csproj TrackHubCommon/src/Common.Domain/
COPY TrackHubCommon/src/Common.Infrastructure/Common.Infrastructure.csproj TrackHubCommon/src/Common.Infrastructure/
COPY TrackHubCommon/src/Common.Web/Common.Web.csproj TrackHubCommon/src/Common.Web/
COPY TrackHubCommon/tests/Common.Application.Tests/Common.Application.Tests.csproj TrackHubCommon/tests/Common.Application.Tests/
COPY TrackHubCommon/tests/Common.Domain.Tests/Common.Domain.Tests.csproj TrackHubCommon/tests/Common.Domain.Tests/
COPY TrackHubCommon/tests/Common.Infrastructure.Tests/Common.Infrastructure.Tests.csproj TrackHubCommon/tests/Common.Infrastructure.Tests/
COPY TrackHubCommon/tests/Common.Web.Tests/Common.Web.Tests.csproj TrackHubCommon/tests/Common.Web.Tests/
COPY TrackHubSecurity/Directory.Build.props TrackHubSecurity/
COPY TrackHubSecurity/src/Application/Application.csproj TrackHubSecurity/src/Application/
COPY TrackHubSecurity/src/DBInitializer/DBInitializer.csproj TrackHubSecurity/src/DBInitializer/
COPY TrackHubSecurity/src/Domain/Domain.csproj TrackHubSecurity/src/Domain/
COPY TrackHubSecurity/src/Infrastructure/ManagerApi/ManagerApi.csproj TrackHubSecurity/src/Infrastructure/ManagerApi/
COPY TrackHubSecurity/src/Infrastructure/SecurityDB/SecurityDB.csproj TrackHubSecurity/src/Infrastructure/SecurityDB/
COPY TrackHubSecurity/src/Web/Web.csproj TrackHubSecurity/src/Web/
COPY TrackHubSecurity/tests/Application.UnitTests/Application.UnitTests.csproj TrackHubSecurity/tests/Application.UnitTests/
COPY TrackHubSecurity/tests/Infrastructure.UnitTests/Infrastructure.UnitTests.csproj TrackHubSecurity/tests/Infrastructure.UnitTests/
COPY TrackHubSecurity/tests/Web.UnitTests/Web.UnitTests.csproj TrackHubSecurity/tests/Web.UnitTests/

RUN dotnet restore TrackHubSecurity/src/Web/Web.csproj

# Then the sources.
COPY TrackHubCommon/ TrackHubCommon/
COPY TrackHubSecurity/ TrackHubSecurity/

RUN dotnet publish TrackHubSecurity/src/Web/Web.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create certificates directory
RUN mkdir -p /app/certificates

# Copy published application
COPY --from=build /app/publish .

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "TrackHub.Security.Web.dll"]
